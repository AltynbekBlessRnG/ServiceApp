EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_LEGAL_BASE_URL=https://your-github-user.github.io/your-repository/legal
# Optional. Set ONLY when Supabase Auth enforces captcha AND its stored
# hCaptcha Secret Key belongs to this same site. Verify the pair first with
# `HCAPTCHA_SECRET=... npm run verify:captcha -- <site-key>`; a mismatched
# pair makes every sign-up fail with `invalid-input-response`.
# Leave unset to run without captcha.
EXPO_PUBLIC_HCAPTCHA_SITE_KEY=

# Configure these as Supabase Edge Function secrets, never as EXPO_PUBLIC values:
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.6-flash
# PUSH_WEBHOOK_SECRET=replace-with-a-long-random-secret
# SENTRY_AUTH_TOKEN=server-side-build-secret
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project
