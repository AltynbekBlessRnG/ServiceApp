{
  "expo": {
    "name": "Taptym",
    "slug": "service-app",
    "owner": "xenodochial",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taptym",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.adiya.serviceapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.adiya.serviceapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0E11"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 2
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0B0E11",
      "visible": "leanback"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0E11"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Taptym показывает мастеров и заведения рядом с вами и сортирует список по расстоянию — например, чтобы барбер в Алматы оказался выше барбера в Астане. Геопозиция передаётся только в поисковый запрос и нигде не сохраняется. Без доступа поиск работает, просто без сортировки по близости.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-notifications",
      "@sentry/react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "Taptym открывает фото, чтобы вы могли поставить аватар профиля и добавить снимки своих работ в портфолио — например, фотографии маникюра, которые увидят клиенты. Приложение читает только те файлы, которые вы выбрали сами.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a236030d-2aad-439a-8fc9-e8124961bc27"
      }
    }
  }
}
