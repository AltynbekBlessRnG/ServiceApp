{
  "name": "taptym",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --clear --tunnel",
    "dev:lan": "expo start --clear --lan",
    "dev:android": "expo start --clear --android",
    "dev:ios": "expo start --clear --ios",
    "dev:web": "expo start --clear --web",
    "devbuild:android": "npx eas build --platform android --profile development",
    "devbuild:ios": "npx eas build --platform ios --profile development",
    "devbuild:all": "npx eas build --platform all --profile development",
    "preview:android": "npx eas build --platform android --profile preview",
    "preview:ios": "npx eas build --platform ios --profile preview",
    "preview:all": "npx eas build --platform all --profile preview",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run-tests.ts",
    "test:db": "supabase test db",
    "verify:captcha": "node scripts/verify-hcaptcha.mjs",
    "types:generate": "supabase gen types typescript --local > types/database.generated.ts",
    "export": "expo export --platform all --output-dir dist",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@hcaptcha/react-native-hcaptcha": "4.1.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@rneui/base": "^4.0.0-rc.8",
    "@rneui/themed": "^4.0.0-rc.8",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.101.4",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~54.0.25",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.9",
    "expo-file-system": "^19.0.19",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.9",
    "expo-location": "~19.0.8",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "^0.32.13",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-video-thumbnails": "~10.0.8",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^0.555.0",
    "pg": "^8.21.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "supabase": "^2.101.0",
    "tsx": "^4.22.3",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.4",
    "npm": ">=10"
  },
  "overrides": {
    "tar": "7.5.22",
    "postcss": "8.5.25",
    "@xmldom/xmldom": "0.8.13",
    "react-native-safe-area-context": "$react-native-safe-area-context"
  },
  "private": true
}
